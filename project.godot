; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can always edit it manually if you know what you're doing.

config_version=5

[application]

config/name="Chronicles of Aetheria"
config/description="2D Action RPG - Explore, Battle, Grow"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/managers/GameManager.gd"
SaveSystem="*res://scripts/managers/SaveSystem.gd"
RankSystem="*res://scripts/systems/RankSystem.gd"
InventorySystem="*res://scripts/systems/InventorySystem.gd"
ShopSystem="*res://scripts/systems/ShopSystem.gd"
CombatSystem="*res://scripts/systems/CombatSystem.gd"
SettingsManager="*res://scripts/managers/SettingsManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

